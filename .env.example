ANTHROPIC_API_KEY=sk-ant-...

# Master Metrics MCP endpoint.
MASTERMETRICS_MCP_URL=https://api.mastermetrics.com/api/v2/mcp

# Auth con MM es OAuth — la app se auto-registra. No hace falta nada más.
# Opcional: pinear client_id después del primer DCR.
# MASTERMETRICS_CLIENT_ID=
# MASTERMETRICS_CLIENT_SECRET=

# Opcional: solo en prod si el redirect_uri no se puede inferir del request.
# NEXT_PUBLIC_APP_URL=https://barbra.tudominio.com

# Analytics provider. Keep mock until the canonical BigQuery view exists.
ANALYTICS_PROVIDER=mock
GCP_PROJECT_ID=barbra-intelligence-69fe6
BIGQUERY_ANALYTICS_VIEW=barbra-intelligence-69fe6.barbra_marts.vw_campaign_daily_performance
BIGQUERY_DEFAULT_CURRENCY=COP

# Firebase web app configuration (Firebase Console → Project settings → Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAxjF8mwzUJbSWLty-KkonVEXJxxr2JrAs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=barbra-intelligence-69fe6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=barbra-intelligence-69fe6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=barbra-intelligence-69fe6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=884904373436
NEXT_PUBLIC_FIREBASE_APP_ID=1:884904373436:web:3c73cc3e89a43a4379b4b9
NEXT_PUBLIC_ENABLE_FIREBASE_AUTH=true

# Server auth. In Google Cloud use Application Default Credentials; locally you
# may supply the complete service-account JSON as a secret.
FIREBASE_PROJECT_ID=barbra-intelligence-69fe6
FIREBASE_SERVICE_ACCOUNT_JSON=
REQUIRE_FIREBASE_AUTH=true
