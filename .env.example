# Public app URL — used to build the short tracking URLs (e.g. https://app.example.com/r/<slug>).
# In local dev use http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the redirect handler to insert scan rows bypassing RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — Dashboard > Account Details. Secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for QR uploads. Defaults to "qr-codes".
CLOUDINARY_QR_FOLDER=qr-codes
