# AI model used by Barbra Intelligence.
ANTHROPIC_API_KEY=
BARBRA_MODEL=claude-sonnet-4-6

# Canonical analytics. The app never connects to ad-platform APIs directly.
ANALYTICS_PROVIDER=bigquery
GCP_PROJECT_ID=barbra-intelligence-69fe6
BIGQUERY_ANALYTICS_VIEW=barbra-intelligence-69fe6.marts.vw_campaign_daily_performance
BIGQUERY_DEFAULT_CURRENCY=COP
BIGQUERY_REPORTING_TIMEZONE=America/Bogota
# Hard cap per query (250 MB) to prevent accidental expensive scans.
BIGQUERY_MAX_BYTES_BILLED=250000000
# Complete JSON for a dedicated read-only BigQuery service account (server only).
BIGQUERY_SERVICE_ACCOUNT_JSON=
# Local-only alternative: absolute path to the same service-account JSON.
BIGQUERY_SERVICE_ACCOUNT_FILE=

# Firebase web app configuration (Firebase Console -> Project settings -> Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=barbra-intelligence-69fe6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=barbra-intelligence-69fe6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=barbra-intelligence-69fe6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=884904373436
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ENABLE_FIREBASE_AUTH=true

# Firebase Admin credentials used only by server routes on Vercel.
FIREBASE_PROJECT_ID=barbra-intelligence-69fe6
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local-only alternative to the inline Firebase service-account JSON.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Set true when server routes should bypass Firestore rules after verifying the user.
FIRESTORE_USE_SERVICE_ACCOUNT=false
# Required only when a runtime stores the PEM private key instead of full JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
REQUIRE_FIREBASE_AUTH=true
